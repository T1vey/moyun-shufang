{
 "schema": "poems-v1",
 "version": "poems-20261026-v1",
 "style": "kai",
 "notice": "唐宋五言、七言绝句（公有领域）。楷书书写，缺字由同源补字库提供。",
 "items": [
  {
   "id": "p01",
   "title": "静夜思",
   "author": "李白",
   "dynasty": "唐",
   "form": "五言绝句",
   "lines": [
    "床前明月光",
    "疑是地上霜",
    "举头望明月",
    "低头思故乡"
   ],
   "note": ""
  },
  {
   "id": "p02",
   "title": "春晓",
   "author": "孟浩然",
   "dynasty": "唐",
   "form": "五言绝句",
   "lines": [
    "春眠不觉晓",
    "处处闻啼鸟",
    "夜来风雨声",
    "花落知多少"
   ],
   "note": ""
  },
  {
   "id": "p03",
   "title": "登鹳雀楼",
   "author": "王之涣",
   "dynasty": "唐",
   "form": "五言绝句",
   "lines": [
    "白日依山尽",
    "黄河入海流",
    "欲穷千里目",
    "更上一层楼"
   ],
   "note": ""
  },
  {
   "id": "p04",
   "title": "相思",
   "author": "王维",
   "dynasty": "唐",
   "form": "五言绝句",
   "lines": [
    "红豆生南国",
    "春来发几枝",
    "愿君多采撷",
    "此物最相思"
   ],
   "note": ""
  },
  {
   "id": "p05",
   "title": "江雪",
   "author": "柳宗元",
   "dynasty": "唐",
   "form": "五言绝句",
   "lines": [
    "千山鸟飞绝",
    "万径人踪灭",
    "孤舟蓑笠翁",
    "独钓寒江雪"
   ],
   "note": ""
  },
  {
   "id": "p06",
   "title": "鹿柴",
   "author": "王维",
   "dynasty": "唐",
   "form": "五言绝句",
   "lines": [
    "空山不见人",
    "但闻人语响",
    "返景入深林",
    "复照青苔上"
   ],
   "note": ""
  },
  {
   "id": "p07",
   "title": "悯农",
   "author": "李绅",
   "dynasty": "唐",
   "form": "五言绝句",
   "lines": [
    "锄禾日当午",
    "汗滴禾下土",
    "谁知盘中餐",
    "粒粒皆辛苦"
   ],
   "note": ""
  },
  {
   "id": "p08",
   "title": "寻隐者不遇",
   "author": "贾岛",
   "dynasty": "唐",
   "form": "五言绝句",
   "lines": [
    "松下问童子",
    "言师采药去",
    "只在此山中",
    "云深不知处"
   ],
   "note": ""
  },
  {
   "id": "p09",
   "title": "画",
   "author": "王维",
   "dynasty": "唐",
   "form": "五言绝句",
   "lines": [
    "远看山有色",
    "近听水无声",
    "春去花还在",
    "人来鸟不惊"
   ],
   "note": "相传为王维所作"
  },
  {
   "id": "p10",
   "title": "竹里馆",
   "author": "王维",
   "dynasty": "唐",
   "form": "五言绝句",
   "lines": [
    "独坐幽篁里",
    "弹琴复长啸",
    "深林人不知",
    "明月来相照"
   ],
   "note": ""
  },
  {
   "id": "p11",
   "title": "鸟鸣涧",
   "author": "王维",
   "dynasty": "唐",
   "form": "五言绝句",
   "lines": [
    "人闲桂花落",
    "夜静春山空",
    "月出惊山鸟",
    "时鸣春涧中"
   ],
   "note": ""
  },
  {
   "id": "p12",
   "title": "杂诗",
   "author": "王维",
   "dynasty": "唐",
   "form": "五言绝句",
   "lines": [
    "君自故乡来",
    "应知故乡事",
    "来日绮窗前",
    "寒梅著花未"
   ],
   "note": ""
  },
  {
   "id": "p13",
   "title": "登乐游原",
   "author": "李商隐",
   "dynasty": "唐",
   "form": "五言绝句",
   "lines": [
    "向晚意不适",
    "驱车登古原",
    "夕阳无限好",
    "只是近黄昏"
   ],
   "note": ""
  },
  {
   "id": "p14",
   "title": "梅花",
   "author": "王安石",
   "dynasty": "宋",
   "form": "五言绝句",
   "lines": [
    "墙角数枝梅",
    "凌寒独自开",
    "遥知不是雪",
    "为有暗香来"
   ],
   "note": ""
  },
  {
   "id": "p15",
   "title": "夜宿山寺",
   "author": "李白",
   "dynasty": "唐",
   "form": "五言绝句",
   "lines": [
    "危楼高百尺",
    "手可摘星辰",
    "不敢高声语",
    "恐惊天上人"
   ],
   "note": ""
  },
  {
   "id": "p16",
   "title": "望庐山瀑布",
   "author": "李白",
   "dynasty": "唐",
   "form": "七言绝句",
   "lines": [
    "日照香炉生紫烟",
    "遥看瀑布挂前川",
    "飞流直下三千尺",
    "疑是银河落九天"
   ],
   "note": ""
  },
  {
   "id": "p17",
   "title": "早发白帝城",
   "author": "李白",
   "dynasty": "唐",
   "form": "七言绝句",
   "lines": [
    "朝辞白帝彩云间",
    "千里江陵一日还",
    "两岸猿声啼不住",
    "轻舟已过万重山"
   ],
   "note": ""
  },
  {
   "id": "p18",
   "title": "赠汪伦",
   "author": "李白",
   "dynasty": "唐",
   "form": "七言绝句",
   "lines": [
    "李白乘舟将欲行",
    "忽闻岸上踏歌声",
    "桃花潭水深千尺",
    "不及汪伦送我情"
   ],
   "note": ""
  },
  {
   "id": "p19",
   "title": "黄鹤楼送孟浩然之广陵",
   "author": "李白",
   "dynasty": "唐",
   "form": "七言绝句",
   "lines": [
    "故人西辞黄鹤楼",
    "烟花三月下扬州",
    "孤帆远影碧空尽",
    "唯见长江天际流"
   ],
   "note": ""
  },
  {
   "id": "p20",
   "title": "枫桥夜泊",
   "author": "张继",
   "dynasty": "唐",
   "form": "七言绝句",
   "lines": [
    "月落乌啼霜满天",
    "江枫渔火对愁眠",
    "姑苏城外寒山寺",
    "夜半钟声到客船"
   ],
   "note": ""
  },
  {
   "id": "p21",
   "title": "九月九日忆山东兄弟",
   "author": "王维",
   "dynasty": "唐",
   "form": "七言绝句",
   "lines": [
    "独在异乡为异客",
    "每逢佳节倍思亲",
    "遥知兄弟登高处",
    "遍插茱萸少一人"
   ],
   "note": ""
  },
  {
   "id": "p22",
   "title": "出塞",
   "author": "王昌龄",
   "dynasty": "唐",
   "form": "七言绝句",
   "lines": [
    "秦时明月汉时关",
    "万里长征人未还",
    "但使龙城飞将在",
    "不教胡马度阴山"
   ],
   "note": ""
  },
  {
   "id": "p23",
   "title": "凉州词",
   "author": "王翰",
   "dynasty": "唐",
   "form": "七言绝句",
   "lines": [
    "葡萄美酒夜光杯",
    "欲饮琵琶马上催",
    "醉卧沙场君莫笑",
    "古来征战几人回"
   ],
   "note": ""
  },
  {
   "id": "p24",
   "title": "山行",
   "author": "杜牧",
   "dynasty": "唐",
   "form": "七言绝句",
   "lines": [
    "远上寒山石径斜",
    "白云生处有人家",
    "停车坐爱枫林晚",
    "霜叶红于二月花"
   ],
   "note": ""
  },
  {
   "id": "p25",
   "title": "清明",
   "author": "杜牧",
   "dynasty": "唐",
   "form": "七言绝句",
   "lines": [
    "清明时节雨纷纷",
    "路上行人欲断魂",
    "借问酒家何处有",
    "牧童遥指杏花村"
   ],
   "note": ""
  },
  {
   "id": "p26",
   "title": "题西林壁",
   "author": "苏轼",
   "dynasty": "宋",
   "form": "七言绝句",
   "lines": [
    "横看成岭侧成峰",
    "远近高低各不同",
    "不识庐山真面目",
    "只缘身在此山中"
   ],
   "note": ""
  },
  {
   "id": "p27",
   "title": "饮湖上初晴后雨",
   "author": "苏轼",
   "dynasty": "宋",
   "form": "七言绝句",
   "lines": [
    "水光潋滟晴方好",
    "山色空蒙雨亦奇",
    "欲把西湖比西子",
    "淡妆浓抹总相宜"
   ],
   "note": ""
  },
  {
   "id": "p28",
   "title": "晓出净慈寺送林子方",
   "author": "杨万里",
   "dynasty": "宋",
   "form": "七言绝句",
   "lines": [
    "毕竟西湖六月中",
    "风光不与四时同",
    "接天莲叶无穷碧",
    "映日荷花别样红"
   ],
   "note": ""
  },
  {
   "id": "p29",
   "title": "泊船瓜洲",
   "author": "王安石",
   "dynasty": "宋",
   "form": "七言绝句",
   "lines": [
    "京口瓜洲一水间",
    "钟山只隔数重山",
    "春风又绿江南岸",
    "明月何时照我还"
   ],
   "note": ""
  },
  {
   "id": "p30",
   "title": "江南春",
   "author": "杜牧",
   "dynasty": "唐",
   "form": "七言绝句",
   "lines": [
    "千里莺啼绿映红",
    "水村山郭酒旗风",
    "南朝四百八十寺",
    "多少楼台烟雨中"
   ],
   "note": ""
  },
  {
   "id": "p31",
   "title": "回乡偶书",
   "author": "贺知章",
   "dynasty": "唐",
   "form": "七言绝句",
   "lines": [
    "少小离家老大回",
    "乡音无改鬓毛衰",
    "儿童相见不相识",
    "笑问客从何处来"
   ],
   "note": ""
  },
  {
   "id": "p32",
   "title": "芙蓉楼送辛渐",
   "author": "王昌龄",
   "dynasty": "唐",
   "form": "七言绝句",
   "lines": [
    "寒雨连江夜入吴",
    "平明送客楚山孤",
    "洛阳亲友如相问",
    "一片冰心在玉壶"
   ],
   "note": ""
  },
  {
   "id": "p33",
   "title": "望天门山",
   "author": "李白",
   "dynasty": "唐",
   "form": "七言绝句",
   "lines": [
    "天门中断楚江开",
    "碧水东流至此回",
    "两岸青山相对出",
    "孤帆一片日边来"
   ],
   "note": ""
  },
  {
   "id": "p34",
   "title": "绝句",
   "author": "杜甫",
   "dynasty": "唐",
   "form": "七言绝句",
   "lines": [
    "两个黄鹂鸣翠柳",
    "一行白鹭上青天",
    "窗含西岭千秋雪",
    "门泊东吴万里船"
   ],
   "note": ""
  },
  {
   "id": "p35",
   "title": "小池",
   "author": "杨万里",
   "dynasty": "宋",
   "form": "七言绝句",
   "lines": [
    "泉眼无声惜细流",
    "树阴照水爱晴柔",
    "小荷才露尖尖角",
    "早有蜻蜓立上头"
   ],
   "note": ""
  },
  {
   "id": "p36",
   "title": "春日",
   "author": "朱熹",
   "dynasty": "宋",
   "form": "七言绝句",
   "lines": [
    "胜日寻芳泗水滨",
    "无边光景一时新",
    "等闲识得东风面",
    "万紫千红总是春"
   ],
   "note": ""
  },
  {
   "id": "p37",
   "title": "游园不值",
   "author": "叶绍翁",
   "dynasty": "宋",
   "form": "七言绝句",
   "lines": [
    "应怜屐齿印苍苔",
    "小扣柴扉久不开",
    "春色满园关不住",
    "一枝红杏出墙来"
   ],
   "note": ""
  },
  {
   "id": "p38",
   "title": "题临安邸",
   "author": "林升",
   "dynasty": "宋",
   "form": "七言绝句",
   "lines": [
    "山外青山楼外楼",
    "西湖歌舞几时休",
    "暖风熏得游人醉",
    "直把杭州作汴州"
   ],
   "note": ""
  },
  {
   "id": "p39",
   "title": "咏柳",
   "author": "贺知章",
   "dynasty": "唐",
   "form": "七言绝句",
   "lines": [
    "碧玉妆成一树高",
    "万条垂下绿丝绦",
    "不知细叶谁裁出",
    "二月春风似剪刀"
   ],
   "note": ""
  },
  {
   "id": "p40",
   "title": "惠崇春江晚景",
   "author": "苏轼",
   "dynasty": "宋",
   "form": "七言绝句",
   "lines": [
    "竹外桃花三两枝",
    "春江水暖鸭先知",
    "蒌蒿满地芦芽短",
    "正是河豚欲上时"
   ],
   "note": ""
  }
 ]
}
