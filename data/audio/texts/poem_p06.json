{
  "id": "poem_p06",
  "category": "poem",
  "title": "鹿柴",
  "author": "王维",
  "dynasty": "唐",
  "sentences": [
    "空山不见人，",
    "但闻人语响。",
    "返景入深林，",
    "复照青苔上。"
  ],
  "source_url": "",
