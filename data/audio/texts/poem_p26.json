{
  "id": "poem_p26",
  "category": "poem",
  "title": "题西林壁",
  "author": "苏轼",
  "dynasty": "宋",
  "sentences": [
    "横看成岭侧成峰，",
    "远近高低各不同。",
    "不识庐山真面目，",
    "只缘身在此山中。"
  ],
