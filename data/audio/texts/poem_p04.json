{
  "id": "poem_p04",
  "category": "poem",
  "title": "相思",
  "author": "王维",
  "dynasty": "唐",
  "sentences": [
    "红豆生南国，",
    "春来发几枝。",
    "愿君多采撷，",
    "此物最相思。"
  ],
  "source_url": "",
  "source_note": "沿用项目诗词库正文；普通话合成，古音与多音字待人工试听。",
