{
  "id": "poem_p20",
  "category": "poem",
  "title": "枫桥夜泊",
  "author": "张继",
  "dynasty": "唐",
  "sentences": [
    "月落乌啼霜满天，",
    "江枫渔火对愁眠。",
    "姑苏城外寒山寺，",
    "夜半钟声到客船。"
  ],
  "source_url": "",
  "source_note": "沿用项目诗词库正文；普通话合成，古音与多音字待人工试听。",
