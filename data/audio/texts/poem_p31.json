{
  "id": "poem_p31",
  "category": "poem",
  "title": "回乡偶书",
  "author": "贺知章",
  "dynasty": "唐",
  "sentences": [
    "少小离家老大回，",
    "乡音无改鬓毛衰。",
    "儿童相见不相识，",
    "笑问客从何处来。"
  ],
