{
  "id": "poem_p03",
  "category": "poem",
  "title": "登鹳雀楼",
  "author": "王之涣",
  "dynasty": "唐",
  "sentences": [
    "白日依山尽，",
    "黄河入海流。",
    "欲穷千里目，",
    "更上一层楼。"
  ],
  "source_url": "",
