{
  "id": "poem_p12",
  "category": "poem",
  "title": "杂诗",
  "author": "王维",
  "dynasty": "唐",
  "sentences": [
    "君自故乡来，",
    "应知故乡事。",
    "来日绮窗前，",
    "寒梅著花未。"
  ],
