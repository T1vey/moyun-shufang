{
  "id": "poem_p09",
  "category": "poem",
  "title": "画",
  "author": "王维",
  "dynasty": "唐",
  "sentences": [
    "远看山有色，",
    "近听水无声。",
    "春去花还在，",
    "人来鸟不惊。"
  ],
  "source_url": "",
