{
  "id": "poem_p07",
  "category": "poem",
  "title": "悯农",
  "author": "李绅",
  "dynasty": "唐",
  "sentences": [
    "锄禾日当午，",
    "汗滴禾下土。",
    "谁知盘中餐，",
    "粒粒皆辛苦。"
  ],
