{
  "id": "poem_p13",
  "category": "poem",
  "title": "登乐游原",
  "author": "李商隐",
  "dynasty": "唐",
  "sentences": [
    "向晚意不适，",
    "驱车登古原。",
    "夕阳无限好，",
    "只是近黄昏。"
  ],
