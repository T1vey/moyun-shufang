{
  "id": "poem_p01",
  "category": "poem",
  "title": "静夜思",
  "author": "李白",
  "dynasty": "唐",
  "sentences": [
    "床前明月光，",
    "疑是地上霜。",
    "举头望明月，",
    "低头思故乡。"
  ],
  "source_url": "",
