{
  "id": "poem_p14",
  "category": "poem",
  "title": "梅花",
  "author": "王安石",
  "dynasty": "宋",
  "sentences": [
    "墙角数枝梅，",
    "凌寒独自开。",
    "遥知不是雪，",
    "为有暗香来。"
  ],
