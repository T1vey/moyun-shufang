{
  "id": "poem_p37",
  "category": "poem",
  "title": "游园不值",
  "author": "叶绍翁",
  "dynasty": "宋",
  "sentences": [
    "应怜屐齿印苍苔，",
    "小扣柴扉久不开。",
    "春色满园关不住，",
    "一枝红杏出墙来。"
  ],
  "source_url": "",
  "source_note": "沿用项目诗词库正文；普通话合成，古音与多音字待人工试听。",
