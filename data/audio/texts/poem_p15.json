{
  "id": "poem_p15",
  "category": "poem",
  "title": "夜宿山寺",
  "author": "李白",
  "dynasty": "唐",
  "sentences": [
    "危楼高百尺，",
    "手可摘星辰。",
    "不敢高声语，",
    "恐惊天上人。"
  ],
