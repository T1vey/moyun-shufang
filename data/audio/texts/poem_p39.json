{
  "id": "poem_p39",
  "category": "poem",
  "title": "咏柳",
  "author": "贺知章",
  "dynasty": "唐",
  "sentences": [
    "碧玉妆成一树高，",
    "万条垂下绿丝绦。",
    "不知细叶谁裁出，",
    "二月春风似剪刀。"
  ],
  "source_url": "",
