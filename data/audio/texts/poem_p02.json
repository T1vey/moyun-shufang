{
  "id": "poem_p02",
  "category": "poem",
  "title": "春晓",
  "author": "孟浩然",
  "dynasty": "唐",
  "sentences": [
    "春眠不觉晓，",
    "处处闻啼鸟。",
    "夜来风雨声，",
    "花落知多少。"
  ],
  "source_url": "",
