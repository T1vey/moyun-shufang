{
  "id": "poem_p11",
  "category": "poem",
  "title": "鸟鸣涧",
  "author": "王维",
  "dynasty": "唐",
  "sentences": [
    "人闲桂花落，",
    "夜静春山空。",
    "月出惊山鸟，",
    "时鸣春涧中。"
  ],
  "source_url": "",
